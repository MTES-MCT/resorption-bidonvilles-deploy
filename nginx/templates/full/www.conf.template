server {
    listen 8080;
    server_name ${RB_PROXY_FRONTEND_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    server_name www.${RB_PROXY_FRONTEND_HOST};
    return 301 $scheme://${RB_PROXY_FRONTEND_HOST}$request_uri;
}

server {
    listen 8443 ssl ;
    listen [::]:8443 ssl ;
    http2 on ;
    server_name ${RB_PROXY_FRONTEND_HOST};

    gzip on;
    gzip_proxied any;
    gzip_comp_level 9;
    gzip_vary on;
    gzip_buffers 16 8k;
    gzip_min_length 50;
    gzip_types
    	text/css
    	text/plain
    	text/javascript
    	application/javascript
    	application/json
    	application/x-javascript
    	application/xml
    	application/xml+rss
    	application/xhtml+xml
    	application/x-font-ttf
    	application/x-font-opentype
    	application/vnd.ms-fontobject
    	image/svg+xml
    	image/x-icon
    	application/rss+xml
    	application/atom_xml;

    ssl_certificate ${RB_PROXY_CERTIFICATE_PATH};
    ssl_certificate_key ${RB_PROXY_CERTIFICATE_KEY_PATH};
    ssl_trusted_certificate ${RB_PROXY_TRUSTED_CERTIFICATE_PATH};

    include common/ssl[.]conf;

    location / {
        proxy_pass ${RB_PROXY_WWW_URI};
        proxy_cookie_flags ~ secure samesite=strict;
        include common/headers[.]conf;
        add_header Content-Security-Policy "default-src 'none'; connect-src ws://localhost:*/_nuxt/ https://${RB_PROXY_API_HOST}/ ${RB_PROXY_MATOMO_HOST} https://${RB_PROXY_FRONTEND_HOST}/_nuxt/; font-src 'self'; img-src 'self' ${RB_PROXY_MATOMO_HOST}; media-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'";
        include naxsi/naxsi.rules;
    }
}
